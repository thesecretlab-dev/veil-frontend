# VEIL / TSL runtime. Copy to .env.local. Never commit secrets.
# Local ≠ Fuji ≠ mainnet. This tree serves local until a go-live ceremony.

VEIL_PROFILE=local
# VEIL_LIVE=1 is ignored until a future ceremony. Do not set it to claim public live.

VEIL_NODE_URL=http://127.0.0.1:9660
VEIL_CHAIN_ID=bdRGUMA7rzZFXjbn1ePTjqhAUfTjW94e69p7qZd4puZ3uEosL
VEIL_ORDER_API_BASE=http://127.0.0.1:9098
VEIL_COMPANION_RPC=http://127.0.0.1:8545
# Last local anvil deploy. deploy-rails.mjs writes companion-evm.addresses.json; Mesh reads that file.
ZEROID_REGISTRY=0xa513E6E4b8f2a923D98304ec87F64353C4D5C853

# Mesh — TSL RPC. Clients should hit Mesh, not the node.
MESH_URL=http://127.0.0.1:8787
MESH_PORT=8787
MESH_API_KEY=mesh_local_dev
# MESH_REQUIRE_KEY=1
# MESH_STRICT=1
# MESH_CORS_ORIGIN=https://thesecretlab.app
# MESH_RPM=240
# MESH_MAX_BATCH=20

# Polymarket catalog + CLOB-priced route (default on). Set 0 to hide catalog.
# VEIL_INCLUDE_POLYMARKET=0
# POLYMARKET_CLOB_LIVE=1 requires POLYMARKET_API_KEY, POLYMARKET_API_SECRET, POLYMARKET_API_PASSPHRASE
# POLYMARKET_VENUE=   # companion settlement contract; auto-deploys on first fill
# POLYMARKET_CLOB_API=https://clob.polymarket.com
# POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com

# Order router relay (local default is fine). Empty in production until set.
# VEIL_ORDER_API_KEY=

# Companion wallets (wagmi) talk to Mesh EVM lane, not app-id 22207.
NEXT_PUBLIC_COMPANION_RPC_URL=http://127.0.0.1:3000/api/mesh/v1/evm

# Do not deploy under lost owner 0xB9a05AFC8eff7eE6a84889Bb9C88A89eAA2f96af
# Fuji/mainnet: set VEIL_PROFILE=fuji|mainnet only after endpoints exist. Parked until then.
